generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppRepo {
  id               String   @id @default(uuid())
  slug             String   @unique
  name             String
  githubUrl        String
  shortDescription String
  category         String
  tags             String[]
  readmeSource     String?
  usageGuide       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("app_repos")
}
